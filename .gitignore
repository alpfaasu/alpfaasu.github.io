.DS_Store
photos/.cache.json

# Working notes handed to the ALPFA Mission Control dashboard, not site content.
.alpfa-manifest.json

# Python bytecode from tools/
__pycache__/

# Scratch cache from the browser automation tool, never site content.
.playwright-mcp/

# Untouched originals kept by Update Photos.command. The served copies next to
# them are what the site uses. Full-resolution phone photos would bloat a repo
# that GitHub Pages serves, and the real backup is the Drive folder they came
# from, so these stay local.
photos/*/_originals/

# Claude Code's per-machine settings for this folder (permission mode). Local
# to Renārs's Mac, never part of the site, and Publish Changes.command does
# git add -A, so this line is what keeps it off the public repo.
.claude/

# Logo candidates the fetch agents drop here before anybody has looked at
# them. Approved files get moved into logos/ by hand; the rest get deleted.
logos/_incoming/
